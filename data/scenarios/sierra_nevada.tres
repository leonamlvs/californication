[gd_resource type="Resource" script_class="ScenarioDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/definitions/ScenarioDefinition.gd" id="1_definition"]
[ext_resource type="Resource" path="res://data/segments/sierra_snow_route.tres" id="2_segment"]
[ext_resource type="Resource" path="res://data/track/snowboard_obstacle_library.tres" id="3_obstacles"]
[ext_resource type="Resource" path="res://data/track/normal_collectible_layouts.tres" id="4_collectibles"]
[ext_resource type="PackedScene" path="res://scenarios/sierra_nevada/SierraEnvironment.tscn" id="5_environment"]
[ext_resource type="Resource" path="res://data/camera_profiles/sierra_follow.tres" id="6_camera"]
[ext_resource type="Resource" path="res://data/transitions/sierra_train.tres" id="7_transition"]
[ext_resource type="Resource" path="res://data/movement_profiles/snowboard_default.tres" id="8_movement"]
[ext_resource type="Resource" path="res://data/track/snowboard_capabilities.tres" id="9_capabilities"]

[ext_resource type="Resource" path="res://data/audio/sierra_nevada.tres" id="rehab_audio"]
[sub_resource type="Resource" id="Resource_hud_coordinates"]



[resource]
script = ExtResource("1_definition")
id = &"sierra_nevada"
display_name = "Sierra Nevada"
movement_mode = &"SNOWBOARD"
base_speed = 12.0
max_speed = 18.0
lane_spacing = 1.8
segment_library = Array[SegmentDefinition]([ExtResource("2_segment")])
obstacle_library = ExtResource("3_obstacles")
collectible_patterns = ExtResource("4_collectibles")
environment_scene = ExtResource("5_environment")
camera_profile = ExtResource("6_camera")
hud_coordinate_profile = SubResource("Resource_hud_coordinates")
transition_definition = ExtResource("7_transition")
minimum_transition_time = 40.0
guaranteed_transition_time = 55.0
development_minimum_transition_time = 15.0
development_guaranteed_transition_time = 20.0
movement_profile = ExtResource("8_movement")
movement_capability_profile = ExtResource("9_capabilities")

ambience_profile = ExtResource("rehab_audio")
sky_color = Color(0.48, 0.63, 0.75, 1)
control_hint = "Left/Right: lanes\nUp: jump   Down: slide"
