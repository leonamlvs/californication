[ext_resource type="Resource" path="res://data/track/golden_gate_obstacle_library.tres" id="3"]
[ext_resource type="Resource" path="res://data/track/normal_collectible_layouts.tres" id="4"]
[ext_resource type="PackedScene" path="res://scenarios/golden_gate/GoldenGateEnvironment.tscn" id="5"]
[ext_resource type="Resource" path="res://data/camera_profiles/golden_gate_follow.tres" id="6"]
