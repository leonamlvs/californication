[resource]
script=ExtResource("1")
id=&"golden_gate"
display_name="Golden Gate Bridge"
movement_mode=&"CAR"
base_speed=14.0
max_speed=20.0
lane_spacing=2.0
segment_library=Array[SegmentDefinition]([ExtResource("2")])
obstacle_library=ExtResource("3")
collectible_patterns=ExtResource("4")
environment_scene=ExtResource("5")
camera_profile=ExtResource("6")
hud_coordinate_profile=SubResource("hud")
transition_definition=ExtResource("7")
minimum_transition_time=40.0
guaranteed_transition_time=55.0
development_minimum_transition_time=15.0
development_guaranteed_transition_time=20.0
movement_profile=ExtResource("8")
movement_capability_profile=ExtResource("9")
failure_family=&"launch"

ambience_profile = ExtResource("rehab_audio")
sky_color = Color(0.36, 0.54, 0.62, 1)
control_hint = "Left/Right: steer\nUp: ramp jump"
