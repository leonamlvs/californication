[gd_resource type="Resource" script_class="ScenarioDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://data/definitions/ScenarioDefinition.gd" id="1_definition"]
[ext_resource type="Resource" path="res://data/segments/graybox_straight.tres" id="2_segment"]
[ext_resource type="Resource" path="res://data/track/graybox_obstacle_library.tres" id="3_obstacles"]
[ext_resource type="Resource" path="res://data/track/normal_collectible_layouts.tres" id="4_collectibles"]
[ext_resource type="PackedScene" path="res://dev/fixtures/FixtureEnvironmentA.tscn" id="5_environment"]
[ext_resource type="Resource" path="res://dev/fixtures/fixture_transition_a.tres" id="6_transition"]
[ext_resource type="Resource" path="res://data/movement_profiles/run_default.tres" id="7_movement"]

[sub_resource type="Resource" id="Resource_camera"]

[sub_resource type="Resource" id="Resource_hud"]

[resource]
script = ExtResource("1_definition")
id = &"fixture_a"
display_name = "Fixture A"
movement_mode = &"RUN"
base_speed = 10.0
max_speed = 16.0
lane_spacing = 1.6
segment_library = Array[SegmentDefinition]([ExtResource("2_segment")])
obstacle_library = ExtResource("3_obstacles")
collectible_patterns = ExtResource("4_collectibles")
environment_scene = ExtResource("5_environment")
camera_profile = SubResource("Resource_camera")
hud_coordinate_profile = SubResource("Resource_hud")
transition_definition = ExtResource("6_transition")
minimum_transition_time = 40.0
guaranteed_transition_time = 55.0
development_minimum_transition_time = 15.0
development_guaranteed_transition_time = 20.0
movement_profile = ExtResource("7_movement")
